{
  "name": "@taildown/mcp",
  "version": "0.1.0",
  "description": "MCP server for Taildown markup compilation and syntax reference",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node ../../scripts/clean.mjs --package",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@taildown/compiler": "workspace:*",
    "@taildown/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
