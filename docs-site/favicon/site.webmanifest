{
  "name": "Taildown Editor",
  "short_name": "Taildown",
  "description": "Write, preview and export Taildown documents, online or offline.",
  "start_url": "/editor",
  "display": "standalone",
  "theme_color": "#3b82f6",
  "background_color": "#ffffff",
  "icons": [
    {
      "src": "/favicon/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": [
    "developer",
    "productivity",
    "utilities"
  ],
  "orientation": "any",
  "id": "/editor",
  "scope": "/",
  "shortcuts": [
    {
      "name": "Open editor",
      "url": "/editor"
    }
  ],
  "share_target": {
    "action": "/editor-share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/plain",
            "text/markdown",
            ".td",
            ".tdown",
            ".taildown",
            ".md",
            ".txt"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/editor",
      "accept": {
        "text/plain": [
          ".td",
          ".tdown",
          ".taildown"
        ],
        "text/markdown": [
          ".md"
        ]
      }
    }
  ]
}
